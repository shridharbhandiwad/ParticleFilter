{
    "tracker": {
        "num_particles": 1500,
        "resampling_strategy": "systematic",
        "resampling_threshold": 0.5,
        "gating_threshold": 15.0,
        "confirmation_threshold": 3,
        "termination_threshold": 5,
        "state_type": "CT"
    },
    "motion_model": {
        "type": "CT",
        "cv_process_noise_std": 1.0,
        "ca_process_noise_std": 2.5,
        "ct_process_noise_std": 2.0,
        "ct_turn_rate_noise_std": 0.2
    },
    "measurement_model": {
        "range_std": 4.0,
        "azimuth_std_deg": 0.3,
        "elevation_std_deg": 0.3,
        "range_rate_std": 1.0
    },
    "radar": {
        "detection_probability": 0.92,
        "clutter_density": 5e-7,
        "snr_threshold": 10.0,
        "weather_noise_factor": 1.2,
        "scan_rate_hz": 10,
        "range_limits": [100.0, 5000.0]
    },
    "simulation": {
        "scenario": "single_aggressive",
        "duration": 25.0,
        "enable_clutter": true,
        "enable_missed_detections": true
    },
    "evaluation": {
        "association_threshold": 70.0,
        "ospa_cutoff": 100.0,
        "ospa_order": 2
    },
    "visualization": {
        "enable_realtime": true,
        "plot_particles": true,
        "plot_measurements": true,
        "save_plots": true,
        "output_dir": "output_maneuvering"
    }
}
